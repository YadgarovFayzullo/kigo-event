# ---------------------------------------------------------------------------
# KiGo API — the only backing store this app has. It keeps no database of its
# own: tournaments, teams, participants and matches all live on the platform.
# Include the /api prefix.
# ---------------------------------------------------------------------------
BOT_API_URL=https://api.kigo.uz/api/

# Key for the bot-facing endpoints (sent as X-Bot-Api-Key). Only the group
# standings need it; leave unset and that one panel degrades on its own.
BOT_API_KEY=

# Seconds a bot-facing response may be cached. Admin responses are never
# cached: they carry the operator's personal token.
BOT_API_REVALIDATE=60
# Give up on an API request after this many milliseconds.
BOT_API_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Session cookie encryption. Generate with:  openssl rand -base64 32
# Required — the app will not start without it.
# ---------------------------------------------------------------------------
AUTH_SECRET=

# Public origin. Leave unset in development: the origin is taken from the
# request, so sign-in works on whatever port the dev server picks. Set it in
# production when the app sits behind a proxy.
# AUTH_URL=https://crm.kigo.uz
